#: package/contents/ui/ConfigSearch.qml:92
msgctxt "@option:radio"
msgid "Use the plugins and order from Plasma Search"
msgstr "Plugins und Reihenfolge aus der Plasma-Suche verwenden"

#: package/contents/ui/ConfigSearch.qml:99
msgctxt "@option:radio"
msgid "Use only the selected plugins, in this order"
msgstr "Nur die ausgewählten Plugins in dieser Reihenfolge verwenden"

#: package/contents/ui/ConfigSearch.qml:109
msgctxt "@info"
msgid ""
"Results of the first plugin are shown first. Plugins disabled in Plasma "
"Search are not used, even when selected here. The settings of each plugin "
"apply everywhere."
msgstr "Ergebnisse des ersten Plugins werden zuerst angezeigt. In der Plasma-Suche deaktivierte Plugins werden nicht verwendet, auch wenn sie hier ausgewählt sind. Die Einstellungen der einzelnen Plugins gelten überall."

#: package/contents/ui/ConfigSearch.qml:124
msgctxt "@info"
msgid "No search plugins found"
msgstr "Keine Such-Plugins gefunden"

#: package/contents/ui/ConfigSearch.qml:124
msgctxt "@info"
msgid "Loading search plugins…"
msgstr "Such-Plugins werden geladen …"

#: package/contents/ui/ConfigSearch.qml:162
msgctxt "@info %1 is a plugin id"
msgid "%1 (not installed)"
msgstr "%1 (nicht installiert)"

#: package/contents/ui/ConfigSearch.qml:174
msgctxt "@action:button"
msgid "Move Up"
msgstr "Nach oben"

#: package/contents/ui/ConfigSearch.qml:175
msgctxt "@action:button %1 is a plugin name"
msgid "Move %1 up"
msgstr "%1 nach oben verschieben"

#: package/contents/ui/ConfigSearch.qml:187
msgctxt "@action:button"
msgid "Move Down"
msgstr "Nach unten"

#: package/contents/ui/ConfigSearch.qml:188
msgctxt "@action:button %1 is a plugin name"
msgid "Move %1 down"
msgstr "%1 nach unten verschieben"

#: package/contents/ui/ConfigSearch.qml:202
msgctxt "@action:button opens the Plasma Search settings"
msgid "Configure Search Plugins…"
msgstr "Such-Plugins einrichten …"

#: package/contents/config/config.qml:18
msgctxt "@title:group for configuration dialog page"
msgid "Search"
msgstr "Suche"
